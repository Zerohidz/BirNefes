{
  "manifest_version": 3,
  "name": "Bir Nefes \u2014 ekran molas\u0131",
  "version": "1.7.5",
  "update_url": "https://birnefes.zerohidz.com/updates.xml",
  "description": "Telefon uygulamalar\u0131 ve se\u00e7ili siteler i\u00e7in ortak g\u00fcnl\u00fck haklar. Ayda 4 acele ge\u00e7i\u015fi.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://zmanga.zerohidz.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bir Nefes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.whatsapp.com/*",
        "*://*.telegram.org/*",
        "*://*.t.me/*"
      ],
      "js": [
        "sites.js",
        "video.js",
        "content.js"
      ],
      "css": [
        "guard.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "include_globs": [
        "*://tranimeizle.*/*",
        "*://*.tranimeizle.*/*",
        "*://fullhdfilmizlesene.*/*",
        "*://*.fullhdfilmizlesene.*/*"
      ],
      "js": [
        "sites.js",
        "video.js",
        "content.js"
      ],
      "css": [
        "guard.css"
      ],
      "run_at": "document_start"
    }
  ]
}
